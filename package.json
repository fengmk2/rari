{
  "name": "@rari/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint && vp lint crates/ && vp lint crates/ packages/ web/ examples/ test/",
    "lint:fix": "pnpm -r run lint:fix && vp lint crates/ --fix && vp lint crates/ packages/ web/ examples/ test/ --fix",
    "lint:knip": "knip",
    "test:unit": "vp test",
    "test:unit:run": "vp test run",
    "test:unit:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test smoke.spec.ts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@napi-rs/cli": "catalog:build",
    "@playwright/test": "catalog:testing",
    "@types/node": "catalog:typescript",
    "@typescript/native-preview": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint-plugin-de-morgan": "catalog:eslint",
    "knip": "catalog:eslint",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:build"
  },
  "packageManager": "pnpm@11.8.0"
}
